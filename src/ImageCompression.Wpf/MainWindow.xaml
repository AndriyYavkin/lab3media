<Window x:Class="ImageCompression.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:ImageCompression.Wpf.Converters"
        mc:Ignorable="d"
        Title="Experimental Image Compression Benchmarking (DCT vs DWT Haar)"
        Height="900" Width="1440"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:BooleanToVisibilityValueConverter x:Key="BoolToVis"/>
        <converters:DeltaToBrushConverter x:Key="DeltaToBrush"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="310"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1A1A20" BorderBrush="#353540" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button Command="{Binding OpenImageFileCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Margin="0,0,12,0" Padding="12,6">
                        <TextBlock Text="Load Image File..." FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Button>

                    <TextBlock Text="Benchmark Pattern:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,6,0" Foreground="#E2E8F0"/>
                    <ComboBox ItemsSource="{Binding SampleGenerators}"
                              SelectedItem="{Binding SelectedGenerator}"
                              DisplayMemberPath="Title"
                              Width="220" Margin="0,0,12,0"/>

                    <TextBlock Text="Strategy:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,6,0" Foreground="#E2E8F0"/>
                    <ComboBox ItemsSource="{Binding CompressionStrategies}"
                              SelectedItem="{Binding SelectedStrategy}"
                              DisplayMemberPath="Name"
                              Width="220" Margin="0,0,12,0"/>

                    <TextBlock Text="View Mode:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,6,0" Foreground="#E2E8F0"/>
                    <ComboBox ItemsSource="{Binding ViewModes}"
                              SelectedItem="{Binding ViewMode}"
                              Width="180" Margin="0,0,12,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Presets:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#E2E8F0"/>
                    <Button Content="50% Coeffs" Command="{Binding ApplyPresetCommand}" CommandParameter="HighQuality" Margin="0,0,4,0" Padding="8,4"/>
                    <Button Content="10% Coeffs" Command="{Binding ApplyPresetCommand}" CommandParameter="MediumQuality" Margin="0,0,4,0" Padding="8,4"/>
                    <Button Content="2% Coeffs" Command="{Binding ApplyPresetCommand}" CommandParameter="HighCompression" Margin="0,0,4,0" Padding="8,4"/>
                    <Button Content="0.5% Coeffs" Command="{Binding ApplyPresetCommand}" CommandParameter="ExtremeCompression" Margin="0,0,10,0" Padding="8,4"/>

                    <Button Content="Save DCT Image" Command="{Binding SaveDctImageCommand}" Margin="0,0,4,0" Padding="8,4"/>
                    <Button Content="Save DWT Image" Command="{Binding SaveDwtImageCommand}" Padding="8,4"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="12,10,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1C1C20" BorderBrush="#2E2E34" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="ORIGINAL REFERENCE" FontWeight="Bold" FontSize="13" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                        <Border Background="#2A2A32" CornerRadius="3" Padding="6,2" HorizontalAlignment="Right">
                            <TextBlock Text="512 × 512 px • 8-bit Gray" FontSize="11" Foreground="#94A3B8"/>
                        </Border>
                    </DockPanel>

                    <Border Grid.Row="1" Background="#0F0F12" BorderBrush="#2D2D34" BorderThickness="1" CornerRadius="2">
                        <Image Source="{Binding SourceBitmap}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>

                    <Border Grid.Row="2" Background="#16161A" BorderBrush="#282830" BorderThickness="1" CornerRadius="4" Margin="0,8,0,0" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Total Coefficients" FontSize="11" Foreground="#71717A"/>
                                <TextBlock Text="262,144" FontWeight="SemiBold" FontSize="14" Foreground="#E2E8F0"/>
                                <TextBlock Text="Dynamic Range" FontSize="11" Foreground="#71717A" Margin="0,4,0,0"/>
                                <TextBlock Text="[0, 255] (Grayscale)" FontSize="12" Foreground="#94A3B8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Baseline Fidelity" FontSize="11" Foreground="#71717A"/>
                                <TextBlock Text="100.00% Intact" FontWeight="SemiBold" FontSize="14" Foreground="#10B981"/>
                                <TextBlock Text="Target Benchmark" FontSize="11" Foreground="#71717A" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding SelectedGenerator.Title}" FontSize="12" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#1C1C20" BorderBrush="#2E2E34" BorderThickness="1" CornerRadius="4" Margin="3,0,3,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="DCT RECONSTRUCTION" FontWeight="Bold" FontSize="13" Foreground="#F97316" VerticalAlignment="Center"/>
                        <Border Background="#2A2A32" CornerRadius="3" Padding="6,2" HorizontalAlignment="Right">
                            <TextBlock Text="8×8 Matrix Formulation" FontSize="11" Foreground="#FDBA74"/>
                        </Border>
                    </DockPanel>

                    <Border Grid.Row="1" Background="#0F0F12" BorderBrush="#2D2D34" BorderThickness="1" CornerRadius="2">
                        <Image Source="{Binding DctDisplayBitmap}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>

                    <Border Grid.Row="2" Background="#16161A" BorderBrush="#282830" BorderThickness="1" CornerRadius="4" Margin="0,8,0,0" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="PSNR (Fidelity)" FontSize="11" Foreground="#71717A"/>
                                <TextBlock Text="{Binding DctMetrics.FormattedPsnr, FallbackValue='-- dB'}" FontWeight="Bold" FontSize="16" Foreground="#F97316"/>
                                <TextBlock Text="MSE Error" FontSize="11" Foreground="#71717A" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding DctMetrics.FormattedMse, FallbackValue='--'}" FontSize="12" Foreground="#E2E8F0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Retained Coeffs" FontSize="11" Foreground="#71717A"/>
                                <TextBlock FontWeight="SemiBold" FontSize="13" Foreground="#E2E8F0">
                                    <Run Text="{Binding DctMetrics.RetainedCoefficients, Mode=OneWay, FallbackValue='--'}"/>
                                    <Run Text=" (" Foreground="#71717A"/>
                                    <Run Text="{Binding DctMetrics.FormattedRetainedPercentage, Mode=OneWay, FallbackValue='--'}"/>
                                    <Run Text=")" Foreground="#71717A"/>
                                </TextBlock>
                                <TextBlock Text="Compression Ratio / Time" FontSize="11" Foreground="#71717A" Margin="0,4,0,0"/>
                                <TextBlock FontSize="12" Foreground="#94A3B8">
                                    <Run Text="{Binding DctMetrics.FormattedCompressionRatio, Mode=OneWay, FallbackValue='--'}"/>
                                    <Run Text=" • "/>
                                    <Run Text="{Binding DctMetrics.FormattedExecutionTime, Mode=OneWay, FallbackValue='--'}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#1C1C20" BorderBrush="#2E2E34" BorderThickness="1" CornerRadius="4" Margin="6,0,0,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="DWT RECONSTRUCTION" FontWeight="Bold" FontSize="13" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        <Border Background="#2A2A32" CornerRadius="3" Padding="6,2" HorizontalAlignment="Right">
                            <TextBlock Text="2D Orthonormal Haar Wavelet" FontSize="11" Foreground="#7DD3FC"/>
                        </Border>
                    </DockPanel>

                    <Border Grid.Row="1" Background="#0F0F12" BorderBrush="#2D2D34" BorderThickness="1" CornerRadius="2">
                        <Image Source="{Binding DwtDisplayBitmap}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>

                    <Border Grid.Row="2" Background="#16161A" BorderBrush="#282830" BorderThickness="1" CornerRadius="4" Margin="0,8,0,0" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="PSNR (Fidelity)" FontSize="11" Foreground="#71717A"/>
                                <TextBlock Text="{Binding DwtMetrics.FormattedPsnr, FallbackValue='-- dB'}" FontWeight="Bold" FontSize="16" Foreground="#38BDF8"/>
                                <TextBlock Text="MSE Error" FontSize="11" Foreground="#71717A" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding DwtMetrics.FormattedMse, FallbackValue='--'}" FontSize="12" Foreground="#E2E8F0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Retained Coeffs" FontSize="11" Foreground="#71717A"/>
                                <TextBlock FontWeight="SemiBold" FontSize="13" Foreground="#E2E8F0">
                                    <Run Text="{Binding DwtMetrics.RetainedCoefficients, Mode=OneWay, FallbackValue='--'}"/>
                                    <Run Text=" (" Foreground="#71717A"/>
                                    <Run Text="{Binding DwtMetrics.FormattedRetainedPercentage, Mode=OneWay, FallbackValue='--'}"/>
                                    <Run Text=")" Foreground="#71717A"/>
                                </TextBlock>
                                <TextBlock Text="Compression Ratio / Time" FontSize="11" Foreground="#71717A" Margin="0,4,0,0"/>
                                <TextBlock FontSize="12" Foreground="#94A3B8">
                                    <Run Text="{Binding DwtMetrics.FormattedCompressionRatio, Mode=OneWay, FallbackValue='--'}"/>
                                    <Run Text=" • "/>
                                    <Run Text="{Binding DwtMetrics.FormattedExecutionTime, Mode=OneWay, FallbackValue='--'}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#1C1C22" BorderBrush="#33333E" BorderThickness="0,1,0,0" Padding="12,8">
            <TabControl Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="#D4D4D8"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="16,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="border"
                                            Background="#272730"
                                            BorderBrush="#3E3E4C"
                                            BorderThickness="1,1,1,0"
                                            CornerRadius="4,4,0,0"
                                            Margin="0,0,6,0"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#353542"/>
                                            <Setter TargetName="border" Property="BorderBrush" Value="#525264"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <TabItem Header="Compression Control &amp; Parameters">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="420"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#141418" BorderBrush="#2D2D36" BorderThickness="1" CornerRadius="4" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Interactive Thresholding / Pruning Controls" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,12"/>

                                <StackPanel Visibility="{Binding IsTopCoefficientsStrategySelected, Converter={StaticResource BoolToVis}}">
                                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                        <TextBlock Text="Retained Coefficients Target:" Foreground="#D4D4D8" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                                        <TextBlock FontWeight="Bold" Foreground="#38BDF8" DockPanel.Dock="Right">
                                            <Run Text="{Binding RetentionPercentage, StringFormat={}{0:F2}}"/>
                                            <Run Text="%"/>
                                        </TextBlock>
                                    </DockPanel>
                                    <Slider Minimum="0.1" Maximum="100.0" Value="{Binding RetentionPercentage}" LargeChange="5.0" SmallChange="0.5" TickFrequency="10.0" IsSnapToTickEnabled="False"/>
                                    <TextBlock Text="Retains only the top K% highest-energy coefficients by absolute magnitude for fair comparison." FontSize="11" Foreground="#94A3B8" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsThresholdStrategySelected, Converter={StaticResource BoolToVis}}">
                                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                        <TextBlock Text="Magnitude Cutoff Threshold:" Foreground="#D4D4D8" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                                        <TextBlock Text="{Binding AbsoluteThreshold, StringFormat={}{0:F1}}" FontWeight="Bold" Foreground="#F97316" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <Slider Minimum="0.0" Maximum="150.0" Value="{Binding AbsoluteThreshold}" LargeChange="10.0" SmallChange="1.0"/>
                                    <TextBlock Text="Zeroes all coefficients where |c| &lt; threshold." FontSize="11" Foreground="#94A3B8" Margin="0,5,0,0"/>
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsQuantizationStrategySelected, Converter={StaticResource BoolToVis}}">
                                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                        <TextBlock Text="Quantization Step Q:" Foreground="#D4D4D8" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                                        <TextBlock Text="{Binding QuantizationStep, StringFormat={}{0:F1}}" FontWeight="Bold" Foreground="#10B981" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <Slider Minimum="1.0" Maximum="128.0" Value="{Binding QuantizationStep}" LargeChange="8.0" SmallChange="1.0"/>
                                    <TextBlock Text="Divides coefficients by Q, rounds to nearest integer, and reconstructs." FontSize="11" Foreground="#94A3B8" Margin="0,5,0,0"/>
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsFrequencyCutoffStrategySelected, Converter={StaticResource BoolToVis}}">
                                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                        <TextBlock Text="Frequency Cutoff Diagonal (0-14):" Foreground="#D4D4D8" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                                        <TextBlock Text="{Binding FrequencyCutoffLimit}" FontWeight="Bold" Foreground="#A855F7" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <Slider Minimum="0" Maximum="14" Value="{Binding FrequencyCutoffLimit}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                    <TextBlock Text="Zeroes high-frequency components exceeding diagonal rank." FontSize="11" Foreground="#94A3B8" Margin="0,5,0,0"/>
                                </StackPanel>

                                <Separator Background="#2E2E38" Margin="0,12"/>

                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="Haar Wavelet Levels:" Foreground="#D4D4D8" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding DwtLevels}" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,12,0" DockPanel.Dock="Left"/>
                                    <Slider Minimum="1" Maximum="8" Value="{Binding DwtLevels}" IsSnapToTickEnabled="True" TickFrequency="1" Width="140" DockPanel.Dock="Right"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#141418" BorderBrush="#2D2D36" BorderThickness="1" CornerRadius="4" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Real-Time Compression Analysis Summary" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,10"/>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#1A1A22" BorderBrush="#2C2C38" BorderThickness="1" CornerRadius="3" Margin="0,0,6,0" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="DCT (Cosine Transform)" FontWeight="Bold" Foreground="#F97316"/>
                                            <TextBlock Text="• 8×8 block partitioning" FontSize="12" Foreground="#D4D4D8" Margin="0,6,0,0"/>
                                            <TextBlock Text="• Matrix representation: C = T·B·Tᵀ" FontSize="12" Foreground="#D4D4D8"/>
                                            <TextBlock Text="• Inverse: B = Tᵀ·C·T" FontSize="12" Foreground="#D4D4D8"/>
                                            <TextBlock Text="• Artifacts: Block boundary grid at high compression" FontSize="11" Foreground="#FCA5A5" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="#1A1A22" BorderBrush="#2C2C38" BorderThickness="1" CornerRadius="3" Margin="3,0,3,0" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="DWT (Haar Wavelet)" FontWeight="Bold" Foreground="#38BDF8"/>
                                            <TextBlock Text="• Multi-resolution decomposition" FontSize="12" Foreground="#D4D4D8" Margin="0,6,0,0"/>
                                            <TextBlock Text="• 2D separable orthonormal Haar filter" FontSize="12" Foreground="#D4D4D8"/>
                                            <TextBlock Text="• Conserves total energy (Parseval)" FontSize="12" Foreground="#D4D4D8"/>
                                            <TextBlock Text="• Artifacts: Step-like staircase contours, no block seams" FontSize="11" Foreground="#BAE6FD" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="#1A1A22" BorderBrush="#2C2C38" BorderThickness="1" CornerRadius="3" Margin="6,0,0,0" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="Comparative Advantage" FontWeight="Bold" Foreground="#10B981"/>
                                            <TextBlock Text="PSNR Difference (DWT - DCT):" FontSize="11" Foreground="#94A3B8" Margin="0,6,0,0"/>
                                            <TextBlock Text="{Binding FormattedPsnrDelta}" FontWeight="Bold" FontSize="18" Foreground="{Binding PsnrDelta, Converter={StaticResource DeltaToBrush}}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding DeltaAdvantageLabel}" FontSize="12" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Multi-Level Comparative Experiments">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="Experimental Evaluation Across Multiple Compression Ratios" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Re-run Experiments" Command="{Binding RunComparativeExperimentsCommand}" Margin="0,0,8,0" Padding="10,5"/>
                                <Button Content="Export CSV Report..." Command="{Binding ExportExperimentReportCommand}" Padding="10,5"/>
                            </StackPanel>
                        </DockPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding ExperimentResults}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#2B2B36"
                                  Background="#121215"
                                  RowBackground="#18181F"
                                  AlternatingRowBackground="#21212B"
                                  BorderBrush="#363644"
                                  BorderThickness="1"
                                  HeadersVisibility="Column"
                                  FontSize="13">
                            <DataGrid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="#18181F"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#2563EB"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2B2B3A"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#2563EB"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#262632"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,9"/>
                                    <Setter Property="BorderBrush" Value="#3B3B4C"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Experiment Level" Binding="{Binding CompressionLevel}" Width="200"/>
                                <DataGridTextColumn Header="Kept %" Binding="{Binding RetainedPercentage, StringFormat={}{0:F1}%}" Width="90"/>
                                <DataGridTextColumn Header="Retained Coeffs" Binding="{Binding RetainedCoefficients, StringFormat={}{0:N0}}" Width="130"/>
                                <DataGridTemplateColumn Header="DCT PSNR" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FormattedDctPsnr}" FontWeight="Bold" Foreground="#F97316"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="DWT PSNR" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FormattedDwtPsnr}" FontWeight="Bold" Foreground="#38BDF8"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Δ PSNR (DWT - DCT)" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FormattedDifference}" FontWeight="Bold" Foreground="{Binding PsnrDifference, Converter={StaticResource DeltaToBrush}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="DCT MSE" Binding="{Binding DctMse, StringFormat={}{0:F2}}" Width="100"/>
                                <DataGridTextColumn Header="DWT MSE" Binding="{Binding DwtMse, StringFormat={}{0:F2}}" Width="100"/>
                                <DataGridTemplateColumn Header="Outcome Advantage" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AdvantageSummary}" FontWeight="SemiBold" Foreground="{Binding PsnrDifference, Converter={StaticResource DeltaToBrush}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <Border Grid.Row="3" Background="#141416" BorderBrush="#25252A" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Status: " Foreground="#71717A" FontSize="11"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#E2E8F0" FontSize="11" FontWeight="Medium"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="Input Image: 512×512 Grayscale • Target: net8.0-windows" Foreground="#71717A" FontSize="11"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
